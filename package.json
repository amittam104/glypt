{
	"name": "glypt",
	"version": "0.1.0",
	"description": "An agent-oriented visual icon discovery tool.",
	"scripts": {
		"build": "tsc",
		"dev": "node bin/dev.js",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"keywords": [
		"cli",
		"icons",
		"iconify",
		"mcp",
		"developer-tools"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/amittam104/glypt.git"
	},
	"bugs": {
		"url": "https://github.com/amittam104/glypt/issues"
	},
	"homepage": "https://github.com/amittam104/glypt#readme",
	"author": "Amit Tambulkar",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.11.0",
			"onFail": "download"
		}
	},
	"type": "module",
	"bin": {
		"glypt": "./bin/run.js"
	},
	"oclif": {
		"bin": "glypt",
		"commands": "./dist/commands",
		"dirname": "glypt",
		"topicSeparator": " "
	},
	"dependencies": {
		"@iconify/types": "^2.0.0",
		"@iconify/utils": "^3.1.4",
		"@modelcontextprotocol/server": "^2.0.0",
		"@oclif/core": "^4.13.2",
		"@resvg/resvg-js": "^2.6.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/node": "^18.19.130",
		"oclif": "^4.23.29",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
